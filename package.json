{
  "name": "inkora",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-pnpm.sh",
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint app components/inkora server lib/*.ts scripts/bootstrap.ts scripts/seed.ts scripts/export-work-preview.ts scripts/prepare-reader-images.ts scripts/test-browser.mjs scripts/prepare-test-browser.mjs scripts/serve-work-preview.mjs tests proxy.ts playwright.config.ts playwright.work.config.ts next.config.ts scripts/start-admin-tests.ts playwright.admin.config.ts",
    "dev:next": "next dev",
    "build:next": "next build",
    "start:next": "next start",
    "typecheck": "tsc --noEmit",
    "bootstrap": "node --env-file-if-exists=.env.local --import tsx scripts/bootstrap.ts",
    "seed": "node --env-file-if-exists=.env.local --import tsx scripts/seed.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "format": "prettier --write app components/inkora server lib/*.ts scripts/bootstrap.ts scripts/seed.ts tests",
    "preview:export": "node --import tsx scripts/export-work-preview.ts",
    "images:prepare": "node --env-file-if-exists=.env.local --import tsx scripts/prepare-reader-images.ts",
    "test:browser": "node scripts/test-browser.mjs",
    "test:browser:prepare": "node scripts/prepare-test-browser.mjs",
    "test:preview": "node scripts/test-browser.mjs --config playwright.work.config.ts",
    "test:admin": "node scripts/test-browser.mjs --config playwright.admin.config.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@napi-rs/canvas": "^1.0.9",
    "@shadcn/react": "^0.3.0",
    "@supabase/supabase-js": "^2.117.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "pdfjs-dist": "^6.3.289",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "yauzl": "^3.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.63.0",
    "@sparticuz/chromium": "^153.0.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "json-rpc-2.0": "1.7.1",
    "prettier": "^3.9.9",
    "raw-body": "3.0.2",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  },
  "packageManager": "pnpm@11.25.0"
}
