# Copy to .env.local. Never prefix server secrets with NEXT_PUBLIC_.
DATA_ADAPTER=local
DATA_DIR=.data
APP_URL=http://localhost:3000
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=inkora-private
AUTH_EMAIL_DOMAIN=admins.inkora.local
# Bootstrap only; remove password from environment after initialization.
BOOTSTRAP_USERNAME=dieheartman
BOOTSTRAP_PASSWORD=dieheartman
MAX_IMAGE_MB=30
MAX_EXTRACTED_MB=300

# Optional public presentation config; no bot token is required.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
# Leave empty for a Main Mini App, or enter BotFather app short name.
NEXT_PUBLIC_TELEGRAM_APP_SHORT_NAME=
